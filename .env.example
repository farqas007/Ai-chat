# ===========================================================
#   AI CHAT - Environment Variables
#   Copy this file to .env and fill in your keys
# ===========================================================

# OpenRouter API key (required for AI chat)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Replicate API key (required for image generation)
REPLICATE_API_KEY=your_replicate_api_key_here

# Server port (default: 3000)
PORT=3000

# API token required by the AI/chat/code endpoints.
# Authentication FAILS CLOSED: if this is missing in production,
# the protected endpoints stay unavailable until it is configured.
# In production set: NODE_ENV=production  (or export NODE_ENV=production)
SERVER_API_TOKEN=your_secret_api_token

# Local development convenience ONLY: set to true to run without a token.
# This is ignored when a SERVER_API_TOKEN IS configured and it can NEVER
# apply when NODE_ENV is "production" or "prod". Never enable on a server.
# ALLOW_NO_AUTH=true

# Comma-separated list of allowed browser origins for cross-origin API calls.
# Leave empty to allow same-origin requests only (recommended).
# Example: CORS_ORIGIN=https://app.example.com,https://dev.example.com
CORS_ORIGIN=